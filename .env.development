# rpsd-config development defaults.
# For standalone local dev: cp .env.development .env
# For rpsd-orchestrated dev: rpsd's setup.sh generates .env from this file.
#
# Deployment scenario: Django dev server (HTTP) → PostGIS + Keycloak in Docker
# The app binds to 0.0.0.0:8000 inside the container (hardcoded, not configurable).
# EXTERNAL_PORT is the port users type in their browser — set it to the host-side
# port mapping (default 20100 in devcontainer, override as needed).
#
# IMPORTANT: shared services (config-db, Keycloak) are NOT started by rpsd-config.
# Start them from the rpsd repo first: rpsd/scripts/start-shared.sh

# =============================================================================
# SECURITY
# =============================================================================

# SECURITY WARNING: don't run with debug turned on in production!
DEBUG=true

# SECURITY WARNING: keep the secret key used in production secret!
# An insecure default is built into the app for development convenience.
# Override here if you need a stable key across restarts, or leave unset.
# Generate a secure key for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# DJANGO_SECRET_KEY=your-secure-random-secret-key-minimum-50-characters

# =============================================================================
# EXTERNAL ACCESS (how users reach the app)
# =============================================================================

# These three settings auto-compute CSRF_TRUSTED_ORIGINS.
# EXTERNAL_PORT: the port that appears in the URL users type in their browser.
# It is the host-side port mapping — NOT the internal container port (always 8000).
EXTERNAL_SCHEME=http
EXTERNAL_HOST=localhost
EXTERNAL_PORT=20100

# Hosts/domains the Django app will serve. JSON array syntax required.
# Add the devcontainer forwarded hostname if accessing from a browser outside the container.
ALLOWED_HOSTS=["localhost", "127.0.0.1", "[::1]"]

# --- Proxy / SSL termination (disabled by default, for production use) ---

# Enable these only when Django is behind a trusted reverse proxy handling HTTPS.
# SECURITY: Never expose Django directly to the internet with these enabled!
#   X-Forwarded-Proto: tells Django the original scheme was https
#   USE_X_FORWARDED_HOST: trust the X-Forwarded-Host header
#   USE_X_FORWARDED_PORT: trust the X-Forwarded-Port header
# SECURE_PROXY_SSL_HEADER=["HTTP_X_FORWARDED_PROTO", "https"]
# USE_X_FORWARDED_HOST=true
# USE_X_FORWARDED_PORT=true

# =============================================================================
# DATABASE (PostGIS)
# =============================================================================

# config-db is started by rpsd (start-shared.sh) and exposed on the host at port 20140.
# The app always runs inside the devcontainer, so the host is reached via host.docker.internal.
# rpsd overrides HOST and PORT with the Docker network service name (config-db:5432).
DATABASES__default__HOST=host.docker.internal
DATABASES__default__PORT=20140
DATABASES__default__NAME=rpsd
DATABASES__default__USER=rpsd
DATABASES__default__PASSWORD=rpsd

# Persistent connection lifetime in seconds (0 = close after each request).
# Increase for production to reduce connection overhead (e.g. CONN_MAX_AGE=60).
# DATABASES__default__CONN_MAX_AGE=0

# =============================================================================
# DJANGO
# =============================================================================

# django.contrib.sites framework: must match the Site object in the database.
# The default (1) matches the initial fixture. Change only if you have multiple sites.
SITE_ID=1

# --- Django superuser (optional, first run only) ---
# Uncomment to create the superuser automatically on first startup.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=your-secure-password

# =============================================================================
# GUNICORN
# =============================================================================

# Number of worker processes. A good default is (2 × CPU cores) + 1.
# GUNICORN_WORKERS=2

# Worker timeout in seconds. Increase if requests take longer than 30 s.
# GUNICORN_TIMEOUT=30

# =============================================================================
# OIDC / KEYCLOAK
# =============================================================================

# Provider identifier — must match the OIDC provider record in the database.
OIDC_PROVIDER_ID=keycloak

# Keycloak is started by rpsd (start-shared.sh) and exposed on the host at port 19300.
# KEYCLOAK_DISCOVERY_URL is fetched by the app server (inside the devcontainer), so it
# must use host.docker.internal to reach the host. rpsd overrides this with the Docker
# network service name (keycloak:8080).
KEYCLOAK_DISCOVERY_URL=http://host.docker.internal:19300/realms/rpsd/.well-known/openid-configuration

# These two URLs are browser-facing (the user's browser is redirected to them), so they
# must always use localhost — the address the developer's browser can reach on the host.
# They do NOT need to be overridden per scenario.
OIDC_AUTHORIZATION_ENDPOINT_URL=http://localhost:19300/realms/rpsd/protocol/openid-connect/auth
OIDC_ISSUER_URL=http://localhost:19300/realms/rpsd

# OAuth2 client credentials — must match the Keycloak client configuration.
OIDC_CLIENT_ID=rpsd-config
OIDC_CLIENT_SECRET=change-me

# Fetch the userinfo endpoint after authentication (false = use ID token claims only).
OIDC_FETCH_USERINFO=false

# =============================================================================
# KEYCLOAK ADMIN API (server-to-server for RBAC provisioning)
# =============================================================================

# Base URL used by Django container to call Keycloak Admin API.
# Leave empty to auto-derive from KEYCLOAK_DISCOVERY_URL.
# KEYCLOAK_ADMIN_BASE_URL=http://host.docker.internal:19300

# Target realm for Admin API operations (groups/users provisioning).
# Leave empty to auto-derive from KEYCLOAK_DISCOVERY_URL.
# KEYCLOAK_ADMIN_REALM=rpsd

# Dedicated confidential client for Admin API (service account enabled).
KEYCLOAK_ADMIN_CLIENT_ID=rpsd-config-admin-api

# Client secret for KEYCLOAK_ADMIN_CLIENT_ID.
# Keep this secret local and never commit real production values.
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me

# HTTP timeout for Admin API calls (seconds).
KEYCLOAK_ADMIN_REQUEST_TIMEOUT_SECONDS=10

# Verify TLS certificate when calling Admin API endpoints.
KEYCLOAK_ADMIN_VERIFY_TLS=false

# Root group namespace managed by rpsd-config.
KEYCLOAK_ADMIN_GROUP_ROOT=/rpsd

# =============================================================================
# M2M INGEST AUTHORIZATION (phase 0 baseline)
# =============================================================================

# Deterministic suffix used when building default technical client IDs.
# Example target name: "<company-slug>-default-prod"
M2M_CLIENT_ID_SUFFIX=default-prod

# Encryption key metadata for secret-at-rest protection.
# Keep placeholders in git-tracked files, set real values only in local/runtime .env.
M2M_SECRET_ENCRYPTION_KEY=change-me
M2M_SECRET_ENCRYPTION_KEY_ID=local-dev

# Internal authz endpoint policy (ingest -> config).
M2M_INTERNAL_AUTHZ_REQUIRE_BEARER=true
M2M_INTERNAL_AUTHZ_ALLOWED_CLIENTS_CSV=rpsd-ingest
M2M_INTERNAL_AUTHZ_AUDIENCE=rpsd-config-internal
