{
    "name": "Rapsodia config",
    "dockerComposeFile": [
        "docker-compose.yml"
    ],
    "service": "rpsd-config",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    
    // Mappa le config di Codex/Copilot dal tuo Linux al container
    // Nota: Ho usato la home dell'utente root nel container perché il tuo file specifica "remoteUser": "root"
    "mounts": [
        "source=${localEnv:HOME}/.config,target=/root/.config,type=bind",
        "source=${localEnv:HOME}/.vscode-codex,target=/root/.vscode-codex,type=bind"
    ],

    "otherPortsAttributes": {
        "onAutoForward": "ignore"
    },
    "features": {},
    "runServices": [
        "rpsd-config",
        "rpsd-config-dapr",
        "postgis",
        "keycloak-db",
        "keycloak"
    ],
    "postCreateCommand": "bash scripts/setup-dev.sh",
    "customizations": {
        "vscode": {
            "settings": {
                "remote.forwardOnOpen": false,
                "remote.autoForwardPorts": false,
                "remote.restoreForwardedPorts": false,
                "python.defaultInterpreterPath": "/workspaces/${localWorkspaceFolderBasename}/.venv",
                "python.analysis.autoImportCompletions": true,
                "python.analysis.typeCheckingMode": "basic",
                "python.testing.autoTestDiscoverOnSaveEnabled": false,
                "python.testing.unittestEnabled": true,
                "python.testing.unittestArgs": [
                    "-v",
                    "-s",
                    ".",
                    "-p",
                    "test*.py"
                ],
                "editor.formatOnSave": true,
                "editor.codeActionsOnSave": {
                    "source.fixAll.ruff": "explicit",
                    "source.organizeImports.ruff": "explicit"
                },
                "[python]": {
                    "editor.formatOnSave": true
                }
            },
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "charliermarsh.ruff",
                "rioj7.command-variable",
                "openai.codex",          // L'estensione Codex che cercavi
                "github.copilot",        // Spesso necessaria se Codex è inteso come motore Copilot
                "github.copilot-chat"    // Già che ci siamo, la chat è utile
            ]
        }
    },
    "remoteUser": "root"
}