# ============================================================================
# Production Configuration: Direct HTTP Access (Intranet/Private Network)
# ============================================================================
#
# DEPLOYMENT SCENARIO:
# Nginx (HTTP) → Django/Uvicorn (HTTP)
#
# Use this configuration when:
# - The application is deployed on an intranet or private network
# - Users access the application directly via HTTP (no external gateway)
# - Nginx serves static files and proxies to Django
# - Examples: http://192.1.1.216:7080, http://intranet-server:8080
#
# WORKFLOW:
# 1. Copy this file to .env.base:
#    cp .env.prod-direct.example .env.base
# 2. Create a .env file with your customizations:
#    touch .env
#    # Then edit .env and set:
#    # - DJANGO_SECRET_KEY (generate a secure random key)
#    # - APP_EXTERNAL_HOST (your server's IP or hostname)
#    # - APP_EXTERNAL_PORT (port users will use to access)
#    # - Database credentials
#    # - Keycloak/OIDC settings
# 3. Run: docker compose --profile with-db --profile with-migrate up
#
# IMPORTANT: Never edit .env.base directly with sensitive values!
# Put customizations and secrets in .env
#
# ============================================================================

# ----------------------------------------------------------------------------
# Security (CRITICAL - MUST BE SET FOR PRODUCTION)
# ----------------------------------------------------------------------------
DEBUG=False

# Generate a secure secret key (minimum 50 characters):
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secure-random-secret-key-minimum-50-characters

# Set to your server's IP address or hostname
ALLOWED_HOSTS=["192.1.1.216", "intranet-server"]

# ----------------------------------------------------------------------------
# Application Server Configuration (Internal)
# ----------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8989

# ----------------------------------------------------------------------------
# External Access Configuration
# ----------------------------------------------------------------------------
# These settings auto-configure CSRF_TRUSTED_ORIGINS
# For production direct access:
# - APP_EXTERNAL_SCHEME: "http" (no SSL, direct HTTP access)
# - APP_EXTERNAL_HOST: Your server's IP address or hostname
# - APP_EXTERNAL_PORT: Port users use to access the application
#
# Example: http://192.1.1.216:7080
APP_EXTERNAL_SCHEME=http
APP_EXTERNAL_HOST=192.1.1.216
APP_EXTERNAL_PORT=7080

# NOTE: The docker-compose.yml maps ${APP_EXTERNAL_PORT}:80 for Nginx
# Users access port 7080, Docker forwards to Nginx port 80

# ----------------------------------------------------------------------------
# Database Configuration - Option A: Containerized PostGIS
# ----------------------------------------------------------------------------
# Use for staging or early production deployments
# Deploy with: docker compose --profile with-db up
#
DATABASES__default__NAME=rpsd
DATABASES__default__USER=rpsd
DATABASES__default__PASSWORD=secure_container_password

# ----------------------------------------------------------------------------
# Database Configuration - Option B: External PostGIS
# ----------------------------------------------------------------------------
# Use for full production deployments with managed database
#
# DATABASES__default__HOST=db.example.com
# DATABASES__default__PORT=5432
# DATABASES__default__NAME=rpsd_production
# DATABASES__default__USER=rpsd_user
# DATABASES__default__PASSWORD=production_password
# DATABASES__default__CONN_MAX_AGE=60

# ----------------------------------------------------------------------------
# OIDC / Keycloak Configuration
# ----------------------------------------------------------------------------
SITE_ID=1
OIDC_PROVIDER_ID=keycloak

KEYCLOAK_DISCOVERY_URL=http://keycloak:8080/realms/rapsodia/.well-known/openid-configuration
OIDC_AUTHORIZATION_ENDPOINT_URL=http://192.1.1.216:18080/realms/rapsodia/protocol/openid-connect/auth
OIDC_ISSUER_URL=http://192.1.1.216:18080/realms/rapsodia

OIDC_CLIENT_ID=django
OIDC_CLIENT_SECRET=your-oidc-client-secret

# ----------------------------------------------------------------------------
# Django Superuser (Optional - First Deployment Only)
# ----------------------------------------------------------------------------
# Uncomment to create superuser automatically on first deployment
#
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@intranet.example.com
# DJANGO_SUPERUSER_PASSWORD=your-secure-password
