# Config environment example: asset limits (no credentials).

# Technical asset limits: positive integers; byte limits except archive entry count.
# Restart Config after changing these deployment settings.
CONFIG_ASSETS_MAX_UPLOAD_BYTES=134217728
CONFIG_ASSETS_XSD_MAX_TOTAL_BYTES=134217728
CONFIG_ASSETS_XSD_MAX_FILE_BYTES=8388608
CONFIG_ASSETS_XSD_MAX_FILES=4096
