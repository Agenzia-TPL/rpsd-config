# Django local development configuration (copy to `.env` and adjust as needed).

DEBUG=true

# Add custom local domains here if you map them in /etc/hosts.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],client.localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:12080,http://127.0.0.1:12080,http://client.localhost:12080

POSTGRES_DB=rpsd
POSTGRES_USER=rpsd
POSTGRES_PASSWORD=rpsd
POSTGRES_HOST=postgis
POSTGRES_PORT=5432

SITE_ID=1
OIDC_PROVIDER_ID=keycloak

# Use the same public host for auth, discovery, token, and userinfo.
KEYCLOAK_DISCOVERY_URL=http://keycloak.localhost:18080/realms/rapsodia/.well-known/openid-configuration

# Public endpoint for browser redirect during login.
OIDC_AUTHORIZATION_ENDPOINT_URL=http://keycloak.localhost:18080/realms/rapsodia/protocol/openid-connect/auth

# Public issuer expected in id_token validation.
OIDC_ISSUER_URL=http://keycloak.localhost:18080/realms/rapsodia

# If Django cannot resolve keycloak.localhost from the container, switch to:
# KEYCLOAK_DISCOVERY_URL=http://keycloak:8080/realms/rapsodia/.well-known/openid-configuration

OIDC_CLIENT_ID=django
OIDC_CLIENT_SECRET=django-secret
OIDC_FETCH_USERINFO=false
