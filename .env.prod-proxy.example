# ============================================================================
# Production Configuration: External Gateway with SSL Termination
# ============================================================================
#
# DEPLOYMENT SCENARIO:
# External Gateway (HTTPS) → Nginx (HTTP) → Django/Uvicorn (HTTP)
#
# Use this configuration when:
# - The application is accessed via HTTPS from the internet
# - An external gateway/proxy handles SSL termination
# - The gateway forwards HTTP traffic to your Nginx container
# - Examples: AWS ALB, Cloudflare, Traefik, Nginx reverse proxy, API Gateway
#
# WORKFLOW:
# 1. Copy this file to .env.base:
#    cp .env.prod-proxy.example .env.base
# 2. Create a .env file with your customizations:
#    touch .env
#    # Then edit .env and set:
#    # - DJANGO_SECRET_KEY (generate a secure random key)
#    # - APP_EXTERNAL_SCHEME=https (CRITICAL!)
#    # - APP_EXTERNAL_HOST (your public domain name)
#    # - Database credentials
#    # - Keycloak/OIDC settings
# 3. Run: docker compose --profile with-db --profile with-migrate up
#
# IMPORTANT: Never edit .env.base directly with sensitive values!
# Put customizations and secrets in .env
#
# ============================================================================

# ----------------------------------------------------------------------------
# Security (CRITICAL - MUST BE SET FOR PRODUCTION)
# ----------------------------------------------------------------------------
DEBUG=False

# Generate a secure secret key (minimum 50 characters):
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secure-random-secret-key-minimum-50-characters

# Set to your domain(s)
ALLOWED_HOSTS=["rapsodia.example.com"]

# ----------------------------------------------------------------------------
# Application Server Configuration (Internal)
# ----------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8989

# ----------------------------------------------------------------------------
# External Access Configuration
# ----------------------------------------------------------------------------
# These settings auto-configure CSRF_TRUSTED_ORIGINS
# For production with external gateway:
# - APP_EXTERNAL_SCHEME: MUST be "https" (SSL termination at gateway)
# - APP_EXTERNAL_HOST: Your public domain name
# - APP_EXTERNAL_PORT: Usually 443 (standard HTTPS, omitted from URLs)
#
# Example: https://rapsodia.example.com
APP_EXTERNAL_SCHEME=https
APP_EXTERNAL_HOST=rapsodia.example.com
APP_EXTERNAL_PORT=443

# CRITICAL: Enable proxy header trust so Django knows requests are HTTPS.
# Only safe when Django is behind a trusted proxy — never expose Django directly!
SECURE_PROXY_SSL_HEADER=["HTTP_X_FORWARDED_PROTO", "https"]
USE_X_FORWARDED_HOST=True
USE_X_FORWARDED_PORT=True

# NOTE: For HTTPS deployments, your external gateway handles port 443 → Nginx
# port 80

# ----------------------------------------------------------------------------
# Database Configuration - Option A: Containerized PostGIS
# ----------------------------------------------------------------------------
# Use for staging or early production deployments
# Deploy with: docker compose --profile with-db up
#
# DATABASES__default__NAME=rpsd
# DATABASES__default__USER=rpsd
# DATABASES__default__PASSWORD=secure_container_password

# ----------------------------------------------------------------------------
# Database Configuration - Option B: External PostGIS
# ----------------------------------------------------------------------------
# Use for full production deployments with managed database
#
DATABASES__default__HOST=db.example.com
DATABASES__default__PORT=5432
DATABASES__default__NAME=rpsd_production
DATABASES__default__USER=rpsd_user
DATABASES__default__PASSWORD=production_password
DATABASES__default__CONN_MAX_AGE=60

# ----------------------------------------------------------------------------
# OIDC / Keycloak Configuration
# ----------------------------------------------------------------------------
SITE_ID=1
OIDC_PROVIDER_ID=keycloak

KEYCLOAK_DISCOVERY_URL=https://auth.example.com/realms/rapsodia/.well-known/openid-configuration
OIDC_AUTHORIZATION_ENDPOINT_URL=https://auth.example.com/realms/rapsodia/protocol/openid-connect/auth
OIDC_ISSUER_URL=https://auth.example.com/realms/rapsodia

OIDC_CLIENT_ID=django
OIDC_CLIENT_SECRET=your-oidc-client-secret

# ----------------------------------------------------------------------------
# Django Superuser (Optional - First Deployment Only)
# ----------------------------------------------------------------------------
# Uncomment to create superuser automatically on first deployment
#
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=your-secure-password
