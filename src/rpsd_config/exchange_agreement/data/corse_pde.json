      "language_version": "3.1",
      "reported_5t_result": "OK"
    },
    {
      "code": "NX-002",
      "name": "Ogni corsa ha almeno un DayTypeRef",
      "requirement_type": "PRESENZA",
      "context": "ServiceJourney",
      "relation": "dayTypes/DayTypeRef/@ref, min 1",
      "scope": "",
      "alternatives": "",
      "blocking": "sì",
      "dimensions": "",
      "definition": "//n:TimetableFrame/n:vehicleJourneys/n:ServiceJourney[not(n:dayTypes/n:DayTypeRef/@ref)]",
      "language_version": "1.0",
      "reported_5t_result": "OK"
    },
    {
      "code": "NX-003",
      "name": "Ogni DayTypeRef di corsa risolve un DayType (match su @ref, anche senza @version)",
      "requirement_type": "RIFERIMENTO",
      "context": "ServiceJourney/dayTypes/DayTypeRef",
      "relation": "DayType_AnyKeyRef: DayTypeRef → DayType",
      "scope": "",
      "alternatives": "",
      "blocking": "sì",
      "dimensions": "",
      "definition": "//n:TimetableFrame/n:vehicleJourneys/n:ServiceJourney/n:dayTypes/n:DayTypeRef[not(@ref = //n:ServiceCalendarFrame//n:DayType/@id)]",
      "language_version": "1.0",
      "reported_5t_result": "OK"
    },
    {
      "code": "NX-004",
      "name": "Ogni DayType usato da corse è attivato da almeno un DayTypeAssignment",
      "requirement_type": "COPERTURA",
      "context": "DayType",
      "relation": "DayTypeAssignment/DayTypeRef → DayType (inversa)",
      "scope": "solo DayType puntati da ServiceJourney",
      "alternatives": "",
      "blocking": "sì",
      "dimensions": "",
      "definition": "//n:ServiceCalendarFrame//n:DayType[@id = //n:TimetableFrame/n:vehicleJourneys/n:ServiceJourney/n:dayTypes/n:DayTypeRef/@ref][not(@id = //n:DayTypeAssignment/n:DayTypeRef/@ref)]",
      "language_version": "1.0",
      "reported_5t_result": "KO: 1 DayType usato senza DayTypeAssignment"
    },
    {
      "code": "NX-005",
      "name": "Ogni DayTypeAssignment con OperatingPeriodRef risolve un UicOperatingPeriod",
      "requirement_type": "RIFERIMENTO",
      "context": "DayTypeAssignment/OperatingPeriodRef",
      "relation": "OperatingPeriod_KeyRef: OperatingPeriodRef → UicOperatingPeriod",
      "scope": "",
      "alternatives": "",
      "blocking": "sì",
      "dimensions": "",
      "definition": "//n:DayTypeAssignment/n:OperatingPeriodRef[not(@ref = //n:operatingPeriods/*/@id)]",
      "language_version": "1.0",
      "reported_5t_result": "OK"
    },
    {
      "code": "NX-006",
      "name": "ValidDayBits lungo quanto i giorni FromDate..ToDate",
      "requirement_type": "CALCOLATA",
      "context": "UicOperatingPeriod",
      "relation": "ValidDayBits vs FromDate..ToDate",
      "scope": "",
      "alternatives": "",
      "blocking": "sì",
      "dimensions": "",
      "definition": "//n:UicOperatingPeriod[string-length(normalize-space(n:ValidDayBits)) ne days-from-duration(xs:date(xs:dateTime(n:ToDate)) - xs:date(xs:dateTime(n:FromDate))) + 1]",
      "language_version": "3.1",
      "reported_5t_result": "OK"
    },
    {
      "code": "NX-007",
      "name": "Corsa ricondotta a una Linea (LineRef/LineView/FlexibleLineView diretti, o via ServiceJourneyPattern RouteView o Route)",
      "requirement_type": "ALTERNATIVA",
      "context": "ServiceJourney",
      "relation": "Linea via: LineRef | LineView/LineRef | FlexibleLineView | ServiceJourneyPattern RouteView/LineRef | RouteRef→Route/LineRef",
      "scope": "",
      "alternatives": "5 vie (PRESENZA/RIFERIMENTO)",
      "blocking": "no",
      "dimensions": "Linea",
      "definition": "//n:TimetableFrame/n:vehicleJourneys/n:ServiceJourney[not(n:LineRef/@ref or n:LineView/n:LineRef/@ref or n:FlexibleLineView/n:FlexibleLineRef/@ref)][not(n:ServiceJourneyPatternRef/@ref = //n:ServiceJourneyPattern[n:RouteView/(n:LineRef|n:FlexibleLineRef)/@ref or n:RouteRef/@ref = //n:Route[n:LineRef/@ref or n:FlexibleLineRef/@ref]/@id]/@id)]",
      "language_version": "2.0",
      "reported_5t_result": "OK"
    },
    {
      "code": "NX-008",
      "name": "ServiceJourneyPatternRef di ogni corsa risolve un ServiceJourneyPattern",
      "requirement_type": "RIFERIMENTO",
      "context": "ServiceJourney",
      "relation": "JourneyPattern_KeyRef: ServiceJourneyPatternRef → ServiceJourneyPattern",
      "scope": "",
      "alternatives": "",
      "blocking": "no",
      "dimensions": "Percorso",
      "definition": "//n:TimetableFrame/n:vehicleJourneys/n:ServiceJourney[not(n:ServiceJourneyPatternRef/@ref = //n:ServiceJourneyPattern/@id)]",
      "language_version": "1.0",
      "reported_5t_result": "OK"
    },
    {
      "code": "NX-009",
      "name": "Ogni percorso usato ha almeno 2 StopPointInJourneyPattern con ScheduledStopPointRef",
      "requirement_type": "PRESENZA",
      "context": "ServiceJourneyPattern",
      "relation": "pointsInSequence/StopPointInJourneyPattern[ScheduledStopPointRef], min 2",
      "scope": "solo percorsi puntati da ServiceJourney",
      "alternatives": "",
      "blocking": "no",
      "dimensions": "Fermata, Arco",
      "definition": "//n:ServiceJourneyPattern[@id = //n:TimetableFrame/n:vehicleJourneys/n:ServiceJourney/n:ServiceJourneyPatternRef/@ref][count(n:pointsInSequence/n:StopPointInJourneyPattern[n:ScheduledStopPointRef/@ref]) lt 2]",
      "language_version": "2.0",
      "reported_5t_result": "OK"
    },
    {
      "code": "NX-010",
      "name": "N. passingTimes della corsa = N. fermate del percorso",
      "requirement_type": "CALCOLATA",
      "context": "ServiceJourney",
      "relation": "n. passingTimes = n. StopPointInJourneyPattern del percorso",
      "scope": "",
      "alternatives": "",
      "blocking": "no",
      "dimensions": "Fermata, Arco",
      "definition": "for $sj in //n:TimetableFrame/n:vehicleJourneys/n:ServiceJourney return $sj[count(n:passingTimes/n:TimetabledPassingTime) ne count(//n:ServiceJourneyPattern[@id = $sj/n:ServiceJourneyPatternRef/@ref]/n:pointsInSequence/n:StopPointInJourneyPattern)]",
      "language_version": "2.0",
      "reported_5t_result": "OK"
    },
    {
      "code": "NX-011",
      "name": "Orario di partenza della corsa determinabile",
      "requirement_type": "ALTERNATIVA",
      "context": "ServiceJourney",
      "relation": "DepartureTime | passingTimes/TimetabledPassingTime[1]/DepartureTime",
      "scope": "",
      "alternatives": "2 × PRESENZA",
      "blocking": "no",
      "dimensions": "Fascia oraria, Tipo Domanda",
      "definition": "//n:TimetableFrame/n:vehicleJourneys/n:ServiceJourney[not(n:DepartureTime) and not(n:passingTimes/n:TimetabledPassingTime[1]/n:DepartureTime)]",
      "language_version": "1.0",
      "reported_5t_result": "OK"
    },
    {
      "code": "NX-012",
      "name": "Corsa attribuita a un contratto (diretto da corsa, o inverso da JourneyAccounting.AccountedObjectRef su corsa/percorso)",
      "requirement_type": "ALTERNATIVA",
      "context": "ServiceJourney",
      "relation": "journeyAccountings/…/SupplyContractRef → JourneyAccounting | JourneyAccounting/AccountedObjectRef → corsa o percorso",
      "scope": "",
      "alternatives": "RIFERIMENTO + COPERTURA",
      "blocking": "no",
      "dimensions": "Contratto",
      "definition": "//n:TimetableFrame/n:vehicleJourneys/n:ServiceJourney[not(n:journeyAccountings/n:JourneyAccounting/n:SupplyContractRef/@ref = //n:GeneralFrame/n:members/n:JourneyAccounting/@id)][not((@id, n:ServiceJourneyPatternRef/@ref) = //n:GeneralFrame/n:members/n:JourneyAccounting/n:AccountedObjectRef/@ref)]",
      "language_version": "2.0",
      "reported_5t_result": "OK"
    },
