      "code": "NX-013",
      "name": "Corsa con tipo veicolo (o Train) programmato risolto",
      "requirement_type": "ALTERNATIVA",
      "context": "ServiceJourney",
      "relation": "VehicleTypeRef → VehicleType | TrainRef → Train",
      "scope": "",
      "alternatives": "2 × RIFERIMENTO",
      "blocking": "no",
      "dimensions": "Veicolo",
      "definition": "//n:TimetableFrame/n:vehicleJourneys/n:ServiceJourney[not(n:VehicleTypeRef/@ref = //n:VehicleType/@id or n:TrainRef/@ref = //n:Train/@id)]",
