    "AssetReference": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "role": {
          "enum": [
            "validation_schema",
            "constraint",
            "documentation",
            "example",
            "other"
