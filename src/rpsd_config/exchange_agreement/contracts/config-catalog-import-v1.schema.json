          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "code",
        "version",
        "sha256",
        "role",
        "required"
      ],
      "title": "AssetReference",
      "type": "object"
    },
