# ============================================================================
# Development Configuration: Local Development Environment
# ============================================================================
#
# DEPLOYMENT SCENARIO:
# Django Dev Server (HTTP) → PostGIS + Keycloak in Docker
#
# Use this configuration for:
# - Local development with VS Code devcontainer
# - Django development server (manage.py runserver or uv run server)
# - No Nginx (static files served by Django)
# - HTTP access on localhost
#
# WORKFLOW:
# 1. Copy this file to .env.base:
#    cp .env.dev-local.example .env.base
# 2. (Optional) Customize values by creating a .env file:
#    echo "DATABASES__default__PASSWORD=my-secure-password" > .env
# 3. Run: docker compose up
#
# IMPORTANT: Never edit .env.base directly with sensitive values! It's
# disposable and will be overwritten when switching deployment scenarios.
# Put customizations and secrets in .env
#
# ============================================================================

# ----------------------------------------------------------------------------
# Security (Development Defaults - DO NOT USE IN PRODUCTION)
# ----------------------------------------------------------------------------
# DEBUG=True (default when not set)
# DJANGO_SECRET_KEY has an insecure default (DO NOT USE IN PRODUCTION)
ALLOWED_HOSTS=["localhost", "127.0.0.1", "0.0.0.0"]

# ----------------------------------------------------------------------------
# Application Server Configuration (Internal)
# ----------------------------------------------------------------------------
# APP_PORT: the port Gunicorn/Django binds to INSIDE the container.
# The default (8000) is almost always correct — leave it alone.
# DO NOT set this to the port users access from outside; that is APP_EXTERNAL_PORT.
APP_HOST=0.0.0.0
APP_PORT=8000

# ----------------------------------------------------------------------------
# External Access Configuration
# ----------------------------------------------------------------------------
# These settings auto-configure CSRF_TRUSTED_ORIGINS.
# APP_EXTERNAL_PORT: the port that appears in the URL users type in their browser.
# This is the one to customise per deployment (e.g. 80 for intranet, 443 for HTTPS).
# DO NOT confuse with APP_PORT, which is the internal container bind port.
# Example: http://localhost:20100
APP_EXTERNAL_SCHEME=http
APP_EXTERNAL_HOST=localhost
APP_EXTERNAL_PORT=20100

# ----------------------------------------------------------------------------
# Database Configuration (PostGIS — defaults match Docker container)
# ----------------------------------------------------------------------------
# Uncomment and modify to override defaults:
#
# DATABASES__default__HOST=postgis
# DATABASES__default__PORT=5432
# DATABASES__default__NAME=rpsd
# DATABASES__default__USER=rpsd
# DATABASES__default__PASSWORD=rpsd

# For external PostGIS in development:
# DATABASES__default__HOST=external-db.example.com
# DATABASES__default__PORT=5432
# DATABASES__default__NAME=dev_db
# DATABASES__default__USER=dev_user
# DATABASES__default__PASSWORD=dev_password

# ----------------------------------------------------------------------------
# OIDC / Keycloak Configuration
# ----------------------------------------------------------------------------
OIDC_PROVIDER_ID=keycloak

KEYCLOAK_DISCOVERY_URL=http://keycloak:19300/realms/rapsodia/.well-known/openid-configuration
OIDC_AUTHORIZATION_ENDPOINT_URL=http://localhost:19300/realms/rapsodia/protocol/openid-connect/auth
OIDC_ISSUER_URL=http://localhost:19300/realms/rapsodia
# If you use a hostname alias (e.g. keycloak.localhost mapped in /etc/hosts), override in .env:
# KEYCLOAK_DISCOVERY_URL=http://keycloak.localhost:19300/realms/rapsodia/.well-known/openid-configuration
# OIDC_AUTHORIZATION_ENDPOINT_URL=http://keycloak.localhost:19300/realms/rapsodia/protocol/openid-connect/auth
# OIDC_ISSUER_URL=http://keycloak.localhost:19300/realms/rapsodia

OIDC_CLIENT_ID=django
OIDC_CLIENT_SECRET=django-secret
OIDC_FETCH_USERINFO=False

# ----------------------------------------------------------------------------
# Django Superuser (Optional - First Run Only)
# ----------------------------------------------------------------------------
# Uncomment to create superuser automatically on first deployment
#
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=your-secure-password
