# rpsd-config production defaults.
# Used by Swarm (env_file:) and K8s (configMapGenerator).
# Coordination vars are overridden by the deployment layer.

DEBUG=false

# --- Database (overridden by deployment for actual host/credentials) ---
DATABASES__default__HOST=
DATABASES__default__PORT=5432
DATABASES__default__NAME=rpsd
DATABASES__default__USER=rpsd
DATABASES__default__PASSWORD=

# --- External access ---
EXTERNAL_SCHEME=https
EXTERNAL_HOST=
EXTERNAL_PORT=443

ALLOWED_HOSTS=[]

# --- Keycloak / OIDC ---
SITE_ID=1
OIDC_PROVIDER_ID=keycloak
KEYCLOAK_DISCOVERY_URL=
OIDC_CLIENT_ID=django
OIDC_CLIENT_SECRET=
OIDC_FETCH_USERINFO=false

# --- Keycloak Admin API (server-to-server) ---
KEYCLOAK_ADMIN_BASE_URL=
KEYCLOAK_ADMIN_REALM=rpsd
KEYCLOAK_ADMIN_CLIENT_ID=rpsd-config-admin-api
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_ADMIN_REQUEST_TIMEOUT_SECONDS=10
KEYCLOAK_ADMIN_VERIFY_TLS=true
KEYCLOAK_ADMIN_GROUP_ROOT=/rpsd

# --- M2M ingest authorization ---
M2M_CLIENT_ID_SUFFIX=default-prod
M2M_SECRET_ENCRYPTION_KEY=
M2M_SECRET_ENCRYPTION_KEY_ID=
M2M_INTERNAL_AUTHZ_REQUIRE_BEARER=true
M2M_INTERNAL_AUTHZ_ALLOWED_CLIENTS_CSV=rpsd-ingest
M2M_INTERNAL_AUTHZ_AUDIENCE=rpsd-config-internal
