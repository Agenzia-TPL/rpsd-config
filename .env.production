# rpsd-config production defaults.
# Used by Swarm (env_file:) and K8s (configMapGenerator).
# Coordination vars are overridden by the deployment layer.

DEBUG=false

# --- Database (overridden by deployment for actual host/credentials) ---
DATABASES__default__HOST=
DATABASES__default__PORT=5432
DATABASES__default__NAME=rpsd
DATABASES__default__USER=rpsd
DATABASES__default__PASSWORD=

# --- External access ---
EXTERNAL_SCHEME=https
EXTERNAL_HOST=
EXTERNAL_PORT=443

ALLOWED_HOSTS=[]

# --- Keycloak / OIDC ---
SITE_ID=1
OIDC_PROVIDER_ID=keycloak
KEYCLOAK_DISCOVERY_URL=
OIDC_CLIENT_ID=django
OIDC_CLIENT_SECRET=
OIDC_FETCH_USERINFO=false
OIDC_ALLOW_PLATFORM_ADMIN_SIGNUP_WITHOUT_INVITATION=false

# --- Keycloak Admin API ---
KEYCLOAK_ADMIN_BASE_URL=
KEYCLOAK_ADMIN_REALM=
KEYCLOAK_ADMIN_CLIENT_ID=rpsd-config-admin-api
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_ADMIN_REQUEST_TIMEOUT_SECONDS=10
KEYCLOAK_ADMIN_VERIFY_TLS=true
KEYCLOAK_ADMIN_GROUP_ROOT=/rpsd

# --- M2M company client grants ---
M2M_DEFAULT_ENVIRONMENT=prod
M2M_DEFAULT_CLIENT_SUFFIX=default-prod
M2M_CLIENT_SECRET_KEY_ID=production
M2M_CLIENT_SECRET_ENCRYPTION_KEY=
M2M_API_ENABLED=true
M2M_API_EXPECTED_AUDIENCE=
M2M_API_CLIENT_ID_CLAIM=azp
M2M_API_CLOCK_SKEW_SECONDS=30

CONFIG_ASSETS_STORAGE_PROVIDER=s3
CONFIG_ASSETS_STORAGE_FS_BASE_PATH=/tmp/rpsd-config-assets
CONFIG_ASSETS_STORAGE_S3_BUCKET_NAME=
CONFIG_ASSETS_STORAGE_S3_REGION_NAME=
CONFIG_ASSETS_STORAGE_S3_ENDPOINT_URL=
CONFIG_ASSETS_STORAGE_S3_AWS_ACCESS_KEY_ID=
CONFIG_ASSETS_STORAGE_S3_AWS_SECRET_ACCESS_KEY=
CONFIG_ASSETS_STORAGE_S3_AWS_SESSION_TOKEN=
CONFIG_ASSETS_RABBITMQ_URL=
CONFIG_ASSETS_RABBITMQ_EXCHANGE_TYPE=topic
STORAGE__PROVIDER=s3
STORAGE__S3__BUCKET_NAME=
TRANSPORT__RABBITMQ__URL=
TRANSPORT__RABBITMQ__EXCHANGE=rpsd.config.assets
TRANSPORT__RABBITMQ__EXCHANGE_TYPE=topic
CONFIG_ASSETS_M2M_ALLOWED_CLIENT_IDS=rpsd-validator
CONFIG_ASSETS_RABBITMQ_ENABLED=true
CONFIG_ASSETS_RABBITMQ_EXCHANGE=rpsd.config.assets
